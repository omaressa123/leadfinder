<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free test runner (no xunit: NuGet is not needed). Exit code is non-zero when any check fails. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LeadGen.Core/LeadGen.Core.csproj" />
  </ItemGroup>

</Project>
