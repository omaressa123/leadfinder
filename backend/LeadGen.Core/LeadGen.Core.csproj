<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately has no NuGet packages: the pipeline, scheduling, scoring and connector logic
       must compile and be testable with the .NET SDK alone. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
